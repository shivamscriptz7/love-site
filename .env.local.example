# Copy this file to .env.local (for local dev) and NEVER commit
# .env.local itself — it's already in .gitignore.
#
# For Vercel: add these same variables under
# Project Settings → Environment Variables (not in this file).

# --- Gmail SMTP example (works with any SMTP provider) ---
# 1. Turn on 2-Step Verification on the sending Gmail account:
#    https://myaccount.google.com/security
# 2. Create an "App Password":
#    https://myaccount.google.com/apppasswords
#    (Regular Gmail passwords will NOT work with SMTP.)
# 3. Use that 16-character app password below (not your real password).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=teamwork2177@gmail.com
SMTP_PASS=mkdrzwreyausvhxo

# Where the notification email should be sent. If omitted, falls
# back to `notifyEmail` in lib/site-config.ts.
NOTIFY_EMAIL=shivamshakya2277@gmail.com
